{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "hooks/pi/dist",
    "rootDir": "hooks/pi",
    "declaration": false,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["hooks/pi/**/*.ts"],
  "exclude": ["hooks/pi/dist", "node_modules"]
}
